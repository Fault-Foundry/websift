# Required: personal bot token from BotFather. Never commit the real .env.
TELEGRAM_BOT_TOKEN=

# Required: your numeric Telegram USER IDs, comma-separated (not usernames).
# Empty or invalid list prevents startup. Private chats and groups; sender ID is checked.
ALLOWED_TELEGRAM_USER_IDS=

# Directory containing sqlmap.py and sqlmapapi.py.
SQLMAP_DIR=/usr/share/sqlmap

# auto: HTML login, then browser if no suitable HTML login is found.
AUTH_MODE=auto
# http / js / browser. Authenticated SPA state automatically uses browser discovery.
RECON_MODE=http
RECON_TIMEOUT=300
BROWSER_AUTH_TIMEOUT=90

# Optional credentials for the explicit "defaults" command; empty by default.
DEFAULT_USER_A=
DEFAULT_PASS_A=
DEFAULT_USER_B=
DEFAULT_PASS_B=

# Optional overrides; normally leave commented out.
# AUTH_LOGIN_URL=https://your-lab.example/login
# AUTH_CHECK_URL=https://your-lab.example/account
# AUTH_SUCCESS_REGEX=Logout
# BROWSER_EXECUTABLE=/usr/bin/chromium
# KATANA_BIN=/absolute/path/to/katana
# SCAN_OUTPUT_DIR=/absolute/path/to/private/scan_output
# XSS_ORCHESTRATOR_PATH=/absolute/path/to/xss-orchestrator/run.sh
# RECON_EXCLUDE_REGEX=(?i:/(?:logout|signout|delete|destroy|reset|setup)(?:[/?]|$))
# XSS_EXCLUDE_REGEX=(?i:/(?:logout|signout|delete|destroy|reset|setup)(?:[/?]|$))

# Request limits
# Minimum gap in seconds: 1..60. Raise this to match the program's limits.
# Python HTTP and browser requests share a limiter. Engines use their own delays.
SCAN_REQUEST_INTERVAL=1
# Optional budgets: 0 disables truncation for long-running server jobs.
# Python HTTP + browser budget excludes external engine traffic.
SCAN_MAX_REQUESTS=0
SCAN_MAX_PAGES=0
SCAN_MAX_TARGETS=0
# Whole scan wall-clock limit in seconds, excluding waiting in the queue.
SCAN_TIMEOUT=0
# Coverage settings are separate from request frequency.
# Browser XSS probes submit forms and may create records. Set 0 to disable.
SCAN_BROWSER_FORMS=1
SQLI_LEVEL=3
SQLI_RISK=2
# Boolean, error, UNION, stacked, time-based, inline queries.
SQLI_TECHNIQUES=BEUSTQ
SQLI_TIME_SEC=5
RECON_MAX_DEPTH=3

# Persistent queue, reports and pending credentials. Owner-only directory.
# QUEUE_DIR=/absolute/path/to/private/queue_data

# fast profile only; coverage is identical to bounty. Minimum 0.1 seconds.
FAST_REQUEST_INTERVAL=0.1

# Separate persistent CLI queue (does not require Telegram).
# CLI_QUEUE_DIR=/absolute/path/to/private/cli_queue_data

# Постоянное наблюдение /watch: только bounty, пока работает бот/CLI worker.
WATCH_INTERVAL_HOURS=24
WATCH_FULL_DAYS=7
WATCH_MAX_PAGES=200
WATCH_RECON_TIMEOUT=300
# Katana с JSONL, -fx и -mdp; можно задать абсолютный путь.
# KATANA_BIN=/home/user/go/bin/katana
