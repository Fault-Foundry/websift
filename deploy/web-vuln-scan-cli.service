[Unit]
Description=Web vulnerability scanner CLI queue worker

[Service]
Type=simple
WorkingDirectory=%h/projects/web_vuln_scan
ExecStart=%h/projects/web_vuln_scan/.venv/bin/python -u %h/projects/web_vuln_scan/cli.py worker
Restart=on-failure
RestartSec=10
UMask=0077
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
